# ── 憑證與本機設定(絕不進版控)──
config/app.local.php
config/deploy.local.md
*.local.php
.env

# ── 相依套件 ──
# 注意:只擋 repo 根的 Composer vendor/。
# public/assets/vendor/ 是前端資產(opencc-full.js),必須進版控,
# 否則主機 git clone 拿不到,線上簡繁切換會死。
/vendor/
node_modules/
composer.lock

# ── 執行期產出 ──
/storage/
*.log

# ── 爬蟲產出(原始資料與進度)──
crawler/data/
crawler/cache/
crawler/logs/
crawler/venv/
__pycache__/

# ── 每日開發日誌(刻意不進版控)──
/history/

# ── 系統雜訊 ──
.DS_Store
Thumbs.db
desktop.ini
.history/
crawler/*.lock

# Claude 工作階段的暫存產出(不進版控)
/Claude outputs/
